if(NOT EXISTS "${IMAGE_PATH}" OR NOT EXISTS "${LINKER}")
    message(FATAL_ERROR "PE image and MSVC linker paths are required.")
endif()
execute_process(COMMAND "${LINKER}" /dump /headers /loadconfig "${IMAGE_PATH}"
    RESULT_VARIABLE status OUTPUT_VARIABLE inspection ERROR_VARIABLE error TIMEOUT 15)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "PE inspection failed: ${status} ${error}")
endif()
foreach(required "Dynamic base" "NX compatible" "CF instrumented" "FID table present")
    if(NOT inspection MATCHES "${required}")
        message(FATAL_ERROR "PE hardening requirement is missing: ${required}")
    endif()
endforeach()
if(NOT inspection MATCHES "[\r\n][ \t]+Control Flow Guard[\r\n]")
    message(FATAL_ERROR "PE lacks IMAGE_DLLCHARACTERISTICS_GUARD_CF.")
endif()
if(POINTER_BYTES STREQUAL "8")
    if(NOT inspection MATCHES "High Entropy Virtual Addresses" OR NOT inspection MATCHES "CET compatible")
        message(FATAL_ERROR "x64 PE lacks high entropy ASLR or CET compatibility metadata.")
    endif()
elseif(POINTER_BYTES STREQUAL "4")
    if(NOT inspection MATCHES "[1-9A-Fa-f][0-9A-Fa-f]*[ \t]+Safe Exception Handler Table" OR
       NOT inspection MATCHES "[1-9A-Fa-f][0-9A-Fa-f]*[ \t]+Safe Exception Handler Count")
        message(FATAL_ERROR "x86 PE lacks a SafeSEH table.")
    endif()
else()
    message(FATAL_ERROR "Unexpected PE architecture for the hardening check.")
endif()
message(STATUS "PE hardening passed: ${IMAGE_PATH}")
