{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for the KN Win32 API Monitor shell.",
  "windows": [
    "main"
  ],
  "permissions": [
    "dialog:allow-open",
    "allow-list-native-target-processes",
    "allow-launch-sample-early-bird-capture",
    "allow-capture-sample-fileio-events",
    "allow-capture-sample-fileio-session-events",
    "allow-replay-last-sample-session",
    "allow-replay-session-path",
    "allow-attach-target-process-capture",
    "allow-supervise-process-tree",
    "allow-list-native-operations",
    "allow-cancel-native-operation",
    "allow-list-native-sessions",
    "allow-stop-native-session",
    "allow-start-streaming-attach-session",
    "allow-start-launch-monitor-session",
    "allow-start-daemon-if-needed",
    "allow-native-daemon-status",
    "allow-list-daemon-sessions",
    "allow-audit-daemon-sessions",
    "allow-plan-daemon-recovery",
    "allow-apply-daemon-recovery",
    "allow-prune-stale-daemon-sessions",
    "allow-catalog-native-sessions",
    "allow-query-native-session-catalog",
    "allow-remove-missing-native-session-catalog-entries",
    "allow-build-native-session-catalog-index",
    "allow-query-native-session-catalog-index",
    "allow-remove-missing-native-session-catalog-index-entries",
    "allow-build-native-trace-index",
    "allow-query-native-trace-index",
    "allow-remove-missing-native-trace-index-entries",
    "allow-start-daemon-supervised-session",
    "allow-stop-daemon-session",
    "allow-drain-native-trace-batches",
    "allow-get-backend-status",
    "allow-get-native-helper-architecture",
    "allow-query-target-binary-architecture"
  ],
  "local": true
}
